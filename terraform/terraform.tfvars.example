# Exemple de fichier de variables Terraform.
# 1. Copie ce fichier : cp terraform.tfvars.example terraform.tfvars
# 2. Remplace les valeurs par tes vraies clés secrètes.
# 3. Le fichier terraform.tfvars est automatiquement ignoré par Git, tes secrets sont donc en sécurité.

# --- General ---
tz         = "UTC"
log_level  = "info"
app_key    = "TA_CLE_SECRETE_ADONISJS_ICI"

# --- Admin ---
admin_password = "TON_MOT_DE_PASSE_ADMIN"

# --- Mails ---
mail_provider          = "resend"
resend_api_key         = "re_xxxxx"
mail_from_email        = "no-reply@career-transition-ai.fr"
mail_from_name         = "Career Transition AI"
mail_resend_test_mode  = "true"
mail_resend_test_event = "delivered"

# --- AI (Backend) ---
ai_provider     = "mistral"
mistral_api_key = "TA_CLE_MISTRAL"
mistral_model   = "mistral-small-latest"
openai_api_key  = ""
openai_model    = "gpt-4o-mini"

# --- AI (Frontend / Vite) ---
vite_ai_provider     = "mistral"
vite_mistral_api_key = "TA_CLE_MISTRAL"
vite_gemini_api_key  = ""
