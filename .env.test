TZ=UTC
PORT=3333
HOST=localhost
APP_URL=http://localhost:3333
LOG_LEVEL=error
APP_KEY=tests-only-app-key
NODE_ENV=test
# Store mémoire : `loginAs()` / `withSession()` du client de test (sessionApiClient)
# écrivent directement dans la session, sans rejouer le formulaire de login.
SESSION_DRIVER=memory

# Base de test : PostgreSQL, comme en production — jamais SQLite.
# Aligné sur le service `postgres_test` du docker-compose.yml (profil `test`,
# port hôte 5432) et sur le bloc `env:` des jobs de tests de la CI — les trois
# doivent rester alignés. Le Postgres de dev, lui, écoute sur 5439 avec les
# identifiants `career_transition_ai` : y pointer ferait tourner les tests
# (et leurs `db:truncate`) sur la base de dev.
DB_HOST=localhost
DB_PORT=5432
DB_USER=test
DB_PASSWORD=test
DB_DATABASE=test
# Le Postgres de test ne parle pas TLS
DB_SSL=false

# Pas d'adaptateur database pour la queue en test : les jobs tournent inline
QUEUE_DRIVER=sync

# Jobs d'analyse : pas d'appel réseau en test
AI_PROVIDER=none
