TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=tests-only-app-key
NODE_ENV=test
SESSION_DRIVER=cookie

# Tests use SQLite (forced in config/database.ts when NODE_ENV=test).
SQLITE_DB_PATH=tmp/test.sqlite3

# Avoid queue database adapter during tests
QUEUE_DRIVER=sync

# Jobs d’analyse : pas d’appel réseau en test unitaire
AI_PROVIDER=none

# Keep these for compatibility with env schema (unused in sqlite mode)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app_test_unused
