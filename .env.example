TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development
SESSION_DRIVER=cookie
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app
DB_CONNECTION=postgres

# Clever Cloud (addon PostgreSQL) — optionnel en local. Si tu définis tout le jeu
# POSTGRESQL_ADDON_*, tu peux omettre DB_* sur la plateforme (voir docs/clever-cloud.md).
# POSTGRESQL_ADDON_HOST=
# POSTGRESQL_ADDON_PORT=
# POSTGRESQL_ADDON_USER=
# POSTGRESQL_ADDON_PASSWORD=
# POSTGRESQL_ADDON_DB=

QUEUE_DRIVER=database
# Production Clever Cloud : lancer aussi un worker (console) avec
# CC_WORKER_COMMAND=cd build && node ace.js queue:work — voir docs/clever-cloud.md

# Bootstrap super admin (`database/seeders/admin_seeder.ts`) : mot de passe du compte plateforme.
# Requis seulement quand tu lances ce seeder. Ne pas commiter une vraie valeur ; sur Clever, définir par app (dev/prod).
ADMIN_PASSWORD=

MAIL_PROVIDER=resend
RESEND_API_KEY=xxxx
MAIL_FROM_EMAIL="no-reply@ton-domaine.fr"
MAIL_FROM_NAME="Career Transition AI"
MAIL_RESEND_TEST_MODE=true
MAIL_RESEND_TEST_EVENT=delivered
# MAIL_RESEND_TEST_TO=delivered+onboarding@resend.dev
# MAIL_RESEND_TEST_FROM=onboarding@resend.dev

# Job d’analyse d’exercice (serveur) : mistral | gemini | openai | none
AI_PROVIDER=mistral
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Assistants IA dans le navigateur
VITE_AI_PROVIDER=mistral
# VITE_MISTRAL_API_KEY=
# VITE_GEMINI_API_KEY=
