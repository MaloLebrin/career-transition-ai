TZ=UTC+2
PORT=3333
HOST=localhost
LOG_LEVEL=
APP_KEY=
NODE_ENV=development
SESSION_DRIVER=
# Base : DB_URL (connection string) OU le jeu DB_HOST/DB_PORT/DB_USER/DB_DATABASE
DB_URL=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_DATABASE=
# true par défaut ; false pour un Postgres sans TLS (docker-compose local)
DB_SSL=false

QUEUE_DRIVER=
# Inscription publique (/auth/register) : défaut false en production, true sinon
REGISTRATION_ENABLED=true
# Indexation par les moteurs (config/seo.ts) : false (noindex) par défaut, true sur le domaine final uniquement
SEO_INDEXING=false
# Jeton Google Search Console (balise google-site-verification rendue seulement s'il est défini)
# GOOGLE_SITE_VERIFICATION=
# Suivi des erreurs (config/error_tracking.ts) : rien n'est envoyé sans DSN
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=
DB_CONNECTION=

# Mail
MAIL_PROVIDER=
RESEND_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=

# AI
# Clé serveur uniquement : OCR de CV et suggestions passent par /dashboard/ai/*.
# Jamais de VITE_MISTRAL_API_KEY (tout VITE_* est publié dans le bundle).
MISTRAL_API_KEY=
AI_PROVIDER=

# Admin
ADMIN_PASSWORD=
