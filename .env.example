# Environnement de développement local — `cp .env.example .env` suffit pour
# démarrer (`pnpm dev`) avec le Postgres du docker-compose (`docker compose up -d
# postgres`). Schéma validé au boot : start/env_schema.ts. Production :
# .env.production.example. Une valeur vide compte comme absente.

# --- Application ------------------------------------------------------------
NODE_ENV=development
# Fuseau IANA (jamais la notation POSIX `UTC+2`, qui signifie UTC−2)
TZ=Europe/Paris
PORT=3333
HOST=localhost
# URL publique : base des liens envoyés par e-mail (jamais dérivée de l'en-tête Host)
APP_URL=http://localhost:3333
LOG_LEVEL=info
# Clé de dev uniquement : en générer une propre avec `node ace generate:key`
APP_KEY=dev-only-app-key-regenerate-with-node-ace-generate-key
# Nom du logger (défaut : aucun)
# APP_NAME=career-transition-ai
SESSION_DRIVER=cookie

# --- Base de données ----------------------------------------------------------
# DB_URL (connection string) OU le jeu DB_HOST/DB_PORT/DB_USER/DB_DATABASE.
# Valeurs du service `postgres` du docker-compose.yml.
# DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5439
DB_USER=career_transition_ai
DB_PASSWORD=career_transition_ai_secret
DB_DATABASE=career_transition_ai
# true par défaut ; false pour un Postgres sans TLS (docker-compose local)
DB_SSL=false

# --- Queue --------------------------------------------------------------------
# database (worker séparé : `pnpm dev:worker:all`) ou sync (jobs exécutés inline)
QUEUE_DRIVER=database

# --- Accès et référencement ---------------------------------------------------
# Inscription publique (/auth/register) : défaut false en production, true sinon
REGISTRATION_ENABLED=true
# Indexation par les moteurs (config/seo.ts) : false (noindex) par défaut, true sur le domaine final uniquement
SEO_INDEXING=false
# Jeton Google Search Console (balise google-site-verification rendue seulement s'il est défini)
# GOOGLE_SITE_VERIFICATION=

# --- Stockage des fichiers (config/cloudinary.ts) ----------------------------
# Optionnel en dev : sans identifiants l'app démarre, seul l'export PDF échoue.
# Fichiers de dev rangés sous career-transition/dev (docs/CLOUDINARY.md).
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Suivi des erreurs (config/error_tracking.ts) -----------------------------
# Rien n'est envoyé sans DSN
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=

# --- E-mails (docs/MAIL.md) ---------------------------------------------------
# console : les e-mails (liens d'onboarding compris) sont écrits dans les logs
MAIL_PROVIDER=console
# Requis avec MAIL_PROVIDER=resend
# RESEND_API_KEY=
# Expéditeur : requis en production, repli sur une adresse resend.dev sinon
# MAIL_FROM_EMAIL=
# MAIL_FROM_NAME=
# Destinataire des demandes de contact / démo
# ADMIN_CONTACT_EMAIL=
# Hors production, Resend route vers ses boîtes de test (true par défaut)
# MAIL_RESEND_TEST_MODE=true
# MAIL_RESEND_TEST_EVENT=delivered
# MAIL_RESEND_TEST_TO=
# MAIL_RESEND_TEST_FROM=

# --- IA -----------------------------------------------------------------------
# none : pas d'appel externe. mistral : MISTRAL_API_KEY requise.
# Clé serveur uniquement : OCR de CV et suggestions passent par /dashboard/ai/*.
# Jamais de VITE_MISTRAL_API_KEY (tout VITE_* est publié dans le bundle).
AI_PROVIDER=none
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# --- Front (lu au build par Vite, publié dans le bundle) ----------------------
# VITE_APP_NAME=Career Transition AI

# --- Compte super admin (node ace db:seed --files database/seeders/admin_seeder)
# ADMIN_PASSWORD=
