{
  "name": "career-transition-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "start": "node build/bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "dev:worker": "node ace queue:work",
    "dev:worker:all": "node ace queue:work --queue=default,ai,pdfs,analytics",
    "dev:with-worker": "node bin/dev-with-worker.mjs",
    "test": "node ace test unit integration functional",
    "test:coverage": "c8 node ace test unit integration functional",
    "test:db:up": "docker compose --profile test up -d postgres_test --wait",
    "test:db:down": "docker compose --profile test down postgres_test",
    "test:inertia": "vitest run",
    "test:inertia:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "knip:inertia": "knip -c knip.json --tsConfig tsconfig.inertia.json --include files",
    "knip:inertia:exports": "knip -c knip.json --tsConfig tsconfig.inertia.json --include exports,types,enumMembers",
    "knip:server:exports": "knip -c knip.server.json --tsConfig tsconfig.json --include exports,types,enumMembers",
    "knip:exports": "pnpm run knip:inertia:exports && pnpm run knip:server:exports"
  },
  "imports": {
    "#generated/*": "./.adonisjs/server/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#helpers/*": "./app/helpers/*.js",
    "#dtos/*": "./app/dtos/*.js",
    "#mappers/*": "./app/mappers/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#jobs/*": "./app/jobs/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#utils/*": "./app/utils/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#shared/*": "./shared/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/eslint-config": "^2.1.2",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^1.4.1",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^4.5.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/archiver": "^7.0.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-datepicker": "^7.0.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "3.2.4",
    "c8": "^10.1.3",
    "eslint": "^9.39.4",
    "hot-hook": "^0.4.0",
    "jsdom": "^25.0.1",
    "knip": "^6.2.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.0.0",
    "@adonisjs/core": "^7.3.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/inertia": "^4.2.0",
    "@adonisjs/lucid": "^22.4.0",
    "@adonisjs/queue": "^0.5.1",
    "@adonisjs/session": "^8.0.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/transmit": "^3.0.1",
    "@adonisjs/transmit-client": "^1.1.0",
    "@adonisjs/vite": "^5.1.0",
    "@boringnode/queue": "^0.5.1",
    "@google/genai": "^1.47.0",
    "@headlessui/react": "^2.2.9",
    "@inertiajs/react": "^2.3.18",
    "@mistralai/mistralai": "^2.1.2",
    "@react-pdf/renderer": "^4.5.1",
    "@vinejs/vine": "^4.3.0",
    "archiver": "^7.0.1",
    "date-fns": "^4.1.0",
    "edge.js": "^6.5.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.475.0",
    "luxon": "^3.7.2",
    "motion": "^11.18.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "reflect-metadata": "^0.2.2",
    "remark-gfm": "^4.0.1",
    "resend": "^6.10.0"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "core-js",
      "esbuild",
      "protobufjs"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
