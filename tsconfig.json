{
  "extends": "@adonisjs/tsconfig/tsconfig.app.json",
  "compilerOptions": {
    "paths": {
      "#domains/*": ["./app/domains/*"],
      "#integrations/*": ["./app/integrations/*"],
      "#helpers/*": ["./app/helpers/*"],
      "#models/*": ["./app/models/*"],
      "#validators/*": ["./app/validators/*"],
      "#dtos/*": ["./app/dtos/*"],
      "#jobs/*": ["./app/jobs/*"],
      "#shared/*": ["./shared/*"]
    },
    "rootDir": "./",
    "outDir": "./build",
    "rewriteRelativeImportExtensions": true
  },
  "exclude": ["./inertia/**/*", "node_modules", "build", "tests"],
  "references": [{ "path": "./tsconfig.inertia.json" }]
}
