<!DOCTYPE html>
<html lang="fr">

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Faites le point sur votre carrière à votre rythme : exercices issus des sciences comportementales, analyse assistée par l'IA, expert à la demande. Aussi pour les cabinets de transition professionnelle."
    />
    <meta name="theme-color" content="#f7f5ee" />
    <meta
      name="keywords"
      content="Transition Carrière, bilan de carrière, bilan de compétences, transition professionnelle, reconversion, cabinet, outplacement"
    />
    <meta name="author" content="Transition Carrière" />
    <meta name="robots" content="{{ seo.robots() }}" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap"
    />

    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    @if(seo.googleSiteVerification())
      <meta name="google-site-verification" content="{{ seo.googleSiteVerification() }}" />
    @end
    
    <title inertia>
      Transition Carrière
    </title>

    @stack('dumper')
    @viteReactRefresh({ nonce: cspNonce })
    @inertiaHead()
    @vite(['inertia/app.tsx', `inertia/pages/${page.component}.tsx`], { nonce: cspNonce })
  </head>

  <body class="min-h-screen">
    @inertia()
  </body>

</html>
