# Production — modèle à copier dans le gestionnaire de secrets de l'hébergeur
# (ou en `.env` à côté du compose de prod). Schéma : start/env_schema.ts ;
# détail de chaque variable : docs/DEPLOYMENT.md §5. Remplacer chaque
# `change-me-…` ; ne jamais committer le fichier rempli.

# --- Application ------------------------------------------------------------
NODE_ENV=production
TZ=Europe/Paris
HOST=0.0.0.0
PORT=8080
# URL publique (https, sans / final) : base des liens envoyés par e-mail
APP_URL=https://change-me.example.fr
LOG_LEVEL=info
# `node ace generate:key --show` — changer la clé invalide sessions et données chiffrées
APP_KEY=change-me-generate-with-node-ace-generate-key
SESSION_DRIVER=cookie
# Heap Node plafonné sous la RAM du conteneur (ex. 512 Mo → 384)
# NODE_OPTIONS=--max-old-space-size=384

# --- Base de données ----------------------------------------------------------
# DB_URL OU DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_DATABASE.
DB_URL=postgres://change-me-user:change-me-password@change-me-host:5432/career_transition_ai
# true (défaut) pour un Postgres managé ; false pour le Postgres du compose (sans TLS)
DB_SSL=true

# --- Queue --------------------------------------------------------------------
# Un worker (`queue:work`) tourne à côté du web
QUEUE_DRIVER=database

# --- Accès et référencement ---------------------------------------------------
# Beta fermée : comptes créés par le super admin
REGISTRATION_ENABLED=false
# noindex tant que le domaine final n'est pas en place
SEO_INDEXING=false
# GOOGLE_SITE_VERIFICATION=

# --- Stockage des fichiers (Cloudinary) ---------------------------------------
# Requis en production : l'app refuse de démarrer sans (config/cloudinary.ts)
CLOUDINARY_CLOUD_NAME=change-me-cloud-name
CLOUDINARY_API_KEY=change-me-api-key
CLOUDINARY_API_SECRET=change-me-api-secret

# --- Suivi des erreurs --------------------------------------------------------
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=

# --- E-mails ------------------------------------------------------------------
# console tant qu'aucun domaine n'est vérifié chez Resend (liens dans les logs)
MAIL_PROVIDER=resend
RESEND_API_KEY=change-me-resend-api-key
# Requis en production
MAIL_FROM_EMAIL=no-reply@change-me-domain.fr
MAIL_FROM_NAME=Career Transition AI
ADMIN_CONTACT_EMAIL=contact@change-me-domain.fr
MAIL_RESEND_TEST_MODE=false

# --- IA -----------------------------------------------------------------------
AI_PROVIDER=mistral
MISTRAL_API_KEY=change-me-mistral-api-key
MISTRAL_MODEL=mistral-small-latest

# --- Compte super admin (seed one-shot) ---------------------------------------
ADMIN_PASSWORD=change-me-strong-admin-password
# ADMIN_EMAIL=admin@change-me-domain.fr
